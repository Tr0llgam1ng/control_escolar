APP_NAME=payments-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8004
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Each service owns its own database (SOA: no service reads another's tables)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soa_payments
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Must be the same value in every service and in the gateway
SERVICE_KEY=change-me-shared-service-key

# Service-to-service: ownership checks ask the Catalog Service over HTTP
CATALOG_SERVICE_URL=http://127.0.0.1:8002
# Services allowed to call internal-only endpoints (sent as X-Service-Name)
PAYMENTS_INTERNAL_CALLERS=enrollment-service,catalog-service,auth-service,memberships-service

# ---- Payments ----
PAYMENTS_CURRENCY=MXN
PAYMENTS_TIMEZONE=America/Mexico_City
# A payment reference stays alive this many hours; after that, if unpaid, Control Escolar rejects it.
PAYMENTS_REFERENCE_TTL_HOURS=72

# ---- Invoicing (CFDI 4.0) through the PAC TimbraCFDI (ProFact) ----
# Test:       https://pruebas.timbracfdi33.mx:1444/api   (public test token below)
# Production: https://timbracfdi33.mx:1444/api           (token given by ProFact when the account is created)
INVOICING_PAC_URL=https://pruebas.timbracfdi33.mx:1444/api
INVOICING_PAC_VERSION=v2
INVOICING_PAC_TOKEN=mvpNUXmQfK8=
INVOICING_PAC_TIMEOUT=30
# CA bundle to verify the PAC's HTTPS certificate. Empty = resources/certs/cacert.pem (Mozilla bundle, included).
INVOICING_PAC_CA_BUNDLE=
# Issuer = the school. It must be registered in the PAC with its CSD (the PAC seals the XML).
# Defaults: test issuer of the PAC docs.
INVOICING_ISSUER_RFC=IIA040805DZ4
INVOICING_ISSUER_NAME="INDISTRIA ILUMINADORA DE ALMACENES"
INVOICING_ISSUER_REGIME=626
INVOICING_ISSUER_ZIP=34000
INVOICING_SERIES=ESC
INVOICING_PRODUCT_CODE=86121701
INVOICING_UNIT_CODE=E48
# iva = price includes 16% VAT (broken down) · exento = exempt educational service
INVOICING_TAX_MODE=iva
INVOICING_IVA_RATE=0.160000
