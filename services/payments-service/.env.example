APP_NAME=payments-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8004
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Each service owns its own database (SOA: no service reads another's tables)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soa_payments
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Must be the same value in every service and in the gateway
SERVICE_KEY=change-me-shared-service-key

# Service-to-service: ownership checks ask the Catalog Service over HTTP
CATALOG_SERVICE_URL=http://127.0.0.1:8002
# Services allowed to call internal-only endpoints (sent as X-Service-Name)
PAYMENTS_INTERNAL_CALLERS=enrollment-service,catalog-service,auth-service

# ---- Payments ----
PAYMENTS_CURRENCY=MXN
PAYMENTS_TIMEZONE=America/Mexico_City
# A payment reference stays alive this many hours; after that, if unpaid, Control Escolar rejects it.
PAYMENTS_REFERENCE_TTL_HOURS=72
