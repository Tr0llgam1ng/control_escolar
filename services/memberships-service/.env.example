APP_NAME=memberships-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8005
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=America/Mexico_City

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Each service owns its own database (SOA: no service reads another's tables)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soa_memberships
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Must be the same value in every service and in the gateway
SERVICE_KEY=change-me-shared-service-key

# Service-to-service:
#  - payments-service: is a credit-pack reference paid? (internal endpoint, needs memberships-service in PAYMENTS_INTERNAL_CALLERS)
#  - catalog-service: which teacher record belongs to a user (tutoring)
PAYMENTS_SERVICE_URL=http://127.0.0.1:8004
CATALOG_SERVICE_URL=http://127.0.0.1:8002
MEMBERSHIPS_SERVICE_NAME=memberships-service

# ---- Prices of the modules (credits). Plan limits are edited from the admin screen.
MEMBERSHIPS_TUTORING_COST=60
MEMBERSHIPS_EXTRA_HOUR_COST=25
MEMBERSHIPS_EXTRA_BLOCK_COST=10
