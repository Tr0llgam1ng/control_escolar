PORT=3000
# Comma-separated origins allowed to call the gateway (the React app)
CORS_ORIGIN=http://localhost:5173

# Laravel services (one port each)
AUTH_SERVICE_URL=http://127.0.0.1:8001
CATALOG_SERVICE_URL=http://127.0.0.1:8002
ENROLLMENT_SERVICE_URL=http://127.0.0.1:8003

# Must match SERVICE_KEY in the three Laravel .env files
SERVICE_KEY=change-me-shared-service-key
