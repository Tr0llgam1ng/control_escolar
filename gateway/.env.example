PORT=3000
# Comma-separated origins allowed to call the gateway (the React app)
CORS_ORIGIN=http://localhost:5173

# Laravel services (one port each)
AUTH_SERVICE_URL=http://127.0.0.1:8001
CATALOG_SERVICE_URL=http://127.0.0.1:8002
ENROLLMENT_SERVICE_URL=http://127.0.0.1:8003
PAYMENTS_SERVICE_URL=http://127.0.0.1:8004
MEMBERSHIPS_SERVICE_URL=http://127.0.0.1:8005

# Must match SERVICE_KEY in the Laravel services' .env files
SERVICE_KEY=change-me-shared-service-key

# Cafeteria = Sales System (FastAPI) on the classmate's computer. Use his IPv4 (ipconfig), port 8000.
CAFETERIA_SERVICE_URL=http://192.168.1.50:8000
# Secret used to derive each user's cafeteria password (defaults to SERVICE_KEY). Do not change it once accounts exist.
CAFETERIA_ACCOUNT_SECRET=
# Must match WEBHOOK_SECRET in his .env. Empty = online payment disabled (pay at the counter).
CAFETERIA_WEBHOOK_SECRET=

# Weather widget (OpenWeatherMap, https://openweathermap.org/api). Free key; new keys can take up to 2 hours to activate.
OPENWEATHER_API_KEY=
# City shown by default ("City,COUNTRY"); each user can switch to their location or search another city.
WEATHER_DEFAULT_CITY=Durango,MX
